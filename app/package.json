{
  "name": "app",
  "private": true,
  "type": "module",
  "quattroStarterKit": {
    "version": "1.3.1"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "dev": "vite",
    "build:prod": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "format": "prettier --write src",
    "lint": "eslint .",
    "fix": "npm run format && npm run lint",
    "copy": "node scripts/copy.js",
    "build-copy:prod": "npm run build:prod && npm run copy",
    "build-copy:dev": "npm run build:dev && npm run copy",
    "ios": "npm run ios:all",
    "ios:all": "npm run build-copy:dev && (cd ./deviceDebug && sh run-ios.sh)",
    "ios:build": "(cd ./deviceDebug && sh run-ios.sh -b)",
    "ios:run": "(cd ./deviceDebug && sh run-ios.sh -r)",
    "ios:inspect": "(cd ./deviceDebug && sh run-ios.sh -i)",
    "android": "npm run android:all",
    "android:all": "npm run build-copy:dev && node scripts/run-android.js",
    "android:build": "node scripts/run-android.js -b",
    "android:inspect": "node scripts/run-android.js -i",
    "win": "npm run win:all",
    "win:all": "npm run build-copy:dev && pwsh -ExecutionPolicy Bypass -File ./deviceDebug/run-win.ps1",
    "win:build": "pwsh -File ./deviceDebug/run-win.ps1 -Build",
    "win:run": "pwsh -File ./deviceDebug/run-win.ps1 -Run",
    "mac": "npm run mac:all",
    "mac:all": "npm run build-copy:dev && (cd ./deviceDebug && sh run-mac.sh)",
    "mac:build": "(cd ./deviceDebug && sh run-mac.sh -b)",
    "mac:run": "(cd ./deviceDebug && sh run-mac.sh -r)",
    "i18next:extract": "i18next-cli extract"
  },
  "dependencies": {
    "@babylonjs/core": "^9.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/noto-sans-jp": "^5.2.5",
    "@fontsource/roboto": "^5.2.5",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@pixi/layout": "^3.2.0",
    "@pixi/react": "^8.0.5",
    "@reduxjs/toolkit": "^2.8.2",
    "@tonejs/midi": "^2.0.28",
    "@types/web-bluetooth": "^0.0.21",
    "framer-motion": "^12.12.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.0",
    "react-virtuoso": "^4.12.7",
    "redux-saga": "^1.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.184.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "i18next": "^26.0.3",
    "i18next-cli": "^1.51.5",
    "prettier": "^3.5.3",
    "react-i18next": "^17.0.2",
    "rollup-plugin-license": "^3.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3"
  }
}
