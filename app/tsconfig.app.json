{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // 出力する JavaScript のバージョンを指定
    // iOS 14, Android 10.0 を最小対応バージョンとすることを想定
    "target": "ES2020",
    // クラスのフィールドを `defineProperty` で定義するかどうか（MUI や Vue3 で推奨）
    "useDefineForClassFields": true,
    // 利用する型定義（ES2015 の機能とブラウザ API を含む）
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
    ],
    "types": [
      "web-bluetooth"
    ],
    // 使用するモジュールシステム（Vite では `ESNext` を推奨）
    "module": "ESNext",
    // `.d.ts` ファイルの型チェックをスキップしてビルド速度を向上
    "skipLibCheck": true,

    /* Bundler mode */
    // TypeScript のモジュール解決方法を Vite/webpack 向けに最適化
    "moduleResolution": "bundler",
    // `.ts` 拡張子付きのファイルを import 可能にする
    "allowImportingTsExtensions": true,
    // `package.json` の `type` を無視し、常に ES モジュールとして扱う
    "moduleDetection": "force",
    // TypeScript から JavaScript を出力しない（Vite が処理するため）
    "noEmit": true,
    // JSX の変換方法を `react-jsx` に設定（React の `import` を不要にする）
    "jsx": "react-jsx",

    /* Linting */
    // 厳格な型チェックを有効にする（推奨）
    "strict": true,
    // `switch` 文で `break` がないケースをエラーにする
    "noFallthroughCasesInSwitch": true,
    // import するだけで副作用があるファイルを検出する
    "noUncheckedSideEffectImports": true,
    // .json ファイルのインポートを有効にする
    "resolveJsonModule": true,
  },
  // 型チェックの対象となるディレクトリやファイルを指定
  "include": [
    "src",
    "vite-env.d.ts",
    "src/types/image.d.ts", "i18next-parser.config.js",
  ]
}